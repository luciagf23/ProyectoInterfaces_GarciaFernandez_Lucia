<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="carnet_artista" pageWidth="400" pageHeight="250" columnWidth="360" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d04adf9d-cc9f-4a73-a489-8220ca596fe5">
	<parameter name="id_artista" class="java.lang.Long"/>
	<parameter name="fecha_emision" class="java.sql.Date"/>
	<queryString>
		<![CDATA[SELECT 
            p.id,
            p.nombre,
            a.apodo,
            p.nacionalidad,
            p.email,
            GROUP_CONCAT(e.especialidades SEPARATOR ', ') AS especialidades
        FROM persona p
        LEFT JOIN artista a ON p.id = a.id
        LEFT JOIN artista_especialidades e ON a.id = e.artista_id
        WHERE p.id = $P{id_artista}]]>
	</queryString>
	<field name="id" class="java.lang.Long"/>
	<field name="nombre" class="java.lang.String"/>
	<field name="apodo" class="java.lang.String"/>
	<field name="nacionalidad" class="java.lang.String"/>
	<field name="email" class="java.lang.String"/>
	<field name="especialidades" class="java.lang.String"/>
