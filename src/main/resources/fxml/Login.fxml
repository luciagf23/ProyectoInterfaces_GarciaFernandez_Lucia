<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>

<AnchorPane stylesheets="@../styles/Styles.css"
	xmlns="http://javafx.com/javafx/8.0.72"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.luisdbb.tarea3AD2024base.controller.LoginController">
	<children>
		<Rectangle fill="DODGERBLUE" height="250.0"
			stroke="#ffffff8b" strokeType="INSIDE" width="400.0" />
		<Label fx:id="lblLogin" layoutX="97.0" layoutY="46.0"
			text="Bienvenid@as al circo" textFill="WHITE">
			<font>
				<Font size="20.0" />
			</font>
		</Label>
		<TextField fx:id="username" layoutX="98.0" layoutY="92.0"
			prefHeight="36.0" prefWidth="204.0" promptText="Nombre de usuario" />
		<PasswordField fx:id="password" layoutX="98.0"
			layoutY="141.0" onAction="#login" prefHeight="36.0" prefWidth="204.0"
			promptText="Contraseña" />
		<Button fx:id="btnLogin" layoutX="215.0" layoutY="193.0"
			mnemonicParsing="false" onAction="#login" prefHeight="30.0"
			prefWidth="100.0" styleClass="btnGreen" text="Iniciar sesión"
			textFill="WHITE">


			<font>
				<Font size="13.0" />
			</font>
			<effect>
				<DropShadow blurType="ONE_PASS_BOX" color="#6468b2" />
			</effect>
		</Button>

		<Button fx:id="btnInvitado" layoutX="80.0" layoutY="193.0"
			mnemonicParsing="false" onAction="#verEspectaculos" prefHeight="30.0"
			prefWidth="120.0" styleClass="btnBlue" text="Ver Espectáculos"
			textFill="WHITE">
			<font>
				<Font size="13.0" />
			</font>
			<effect>
				<DropShadow blurType="ONE_PASS_BOX" color="#1965d0" />
			</effect>
		</Button>
	</children>
	<opaqueInsets>
		<Insets />
	</opaqueInsets>
</AnchorPane>
