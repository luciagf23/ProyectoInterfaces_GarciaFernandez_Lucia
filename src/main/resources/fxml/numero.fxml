<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.effect.BlurType?>

<BorderPane prefHeight="600.0" prefWidth="1000.0"
	stylesheets="@/styles/Styles.css" xmlns="http://javafx.com/javafx/23"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.luisdbb.tarea3AD2024base.controller.NumeroController">

	<top>
		<VBox spacing="10.0"
			style="-fx-padding: 10; -fx-background-color: #2a3b4c;">
			<Label fx:id="lblEspectaculo"
				style="-fx-font-size: 16; -fx-font-weight: bold; -fx-text-fill: white;" />
			<Button text="← Volver" onAction="#volver" />
		</VBox>
	</top>

	<center>
		<VBox spacing="10" styleClass="background"
			style="-fx-padding: 10;">

			<TableView fx:id="tablaNumeros" prefHeight="250.0">
				<columns>
					<TableColumn fx:id="colOrden" text="Orden"
						prefWidth="80" />
					<TableColumn fx:id="colNombre" text="Nombre"
						prefWidth="250" />
					<TableColumn fx:id="colDuracion" text="Duración"
						prefWidth="100" />
					<TableColumn fx:id="colArtistas" text="Artistas"
						prefWidth="200.0" />
				</columns>
				<columnResizePolicy>
					<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
				</columnResizePolicy>
			</TableView>
		</VBox>
	</center>

	<bottom>
		<VBox spacing="10.0"
			style="-fx-padding: 10; -fx-background-color: #2a3b4c;">
			<GridPane hgap="10" vgap="10">
				<columnConstraints>
					<ColumnConstraints halignment="RIGHT"
						prefWidth="80" />
					<ColumnConstraints halignment="LEFT"
						prefWidth="200" />
				</columnConstraints>

				<rowConstraints>
					<RowConstraints minHeight="30" />
					<RowConstraints minHeight="30" />
					<RowConstraints minHeight="30" />
				</rowConstraints>

				<Label text="Orden:" textFill="WHITE" GridPane.rowIndex="0"
					GridPane.columnIndex="0" />
				<TextField fx:id="txtOrden" prefWidth="60"
					GridPane.rowIndex="0" GridPane.columnIndex="1" />

				<Label text="Nombre:" textFill="WHITE" GridPane.rowIndex="1"
					GridPane.columnIndex="0" />
				<TextField fx:id="txtNombre" prefWidth="200"
					GridPane.rowIndex="1" GridPane.columnIndex="1" />

				<Label text="Duración:" textFill="WHITE" GridPane.rowIndex="2"
					GridPane.columnIndex="0" />
				<TextField fx:id="txtDuracion" prefWidth="80"
					GridPane.rowIndex="2" GridPane.columnIndex="1" />
			</GridPane>

			<HBox spacing="10.0" alignment="CENTER_LEFT">
				<Button fx:id="btnNuevo" text="Nuevo" onAction="#nuevoNumero"
					style="-fx-background-color: white">

					<effect>
						<DropShadow blurType="ONE_PASS_BOX" color="#1965d0" />
					</effect>
				</Button>
				<Button fx:id="btnGuardar" text="Guardar"
					styleClass="btnGreen" textFill="WHITE" onAction="#guardarNumero">
					<effect>
						<DropShadow blurType="ONE_PASS_BOX" color="#1965d0" />
					</effect>
				</Button>
				<Button fx:id="btnEliminar" text="Eliminar"
					onAction="#eliminarNumero" style="-fx-background-color: white">
					<effect>
						<DropShadow blurType="ONE_PASS_BOX" color="#1965d0" />
					</effect>
				</Button>

			</HBox>
			<ListView fx:id="listaArtistas" prefHeight="150" />


		</VBox>
	</bottom>
</BorderPane>