<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.ContextMenu?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>

<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>

<BorderPane prefHeight="600.0" prefWidth="1000.0"
	stylesheets="@/styles/Styles.css" xmlns="http://javafx.com/javafx/23"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="com.luisdbb.tarea3AD2024base.controller.UserController">
	<top>
		<MenuBar BorderPane.alignment="TOP_LEFT">
			<menus>
				<Menu mnemonicParsing="false" text="Archivo">
					<items>
						<MenuItem mnemonicParsing="false" onAction="#salir"
							text="Salir" />
					</items>
				</Menu>
				<Menu mnemonicParsing="false" text="Editar">
					<items>
						<MenuItem mnemonicParsing="false" text="Eliminar" />
					</items>
				</Menu>
				<Menu mnemonicParsing="false" text="Ayuda">
					<items>
						<MenuItem mnemonicParsing="false" text="Ayuda"
							onAction="#onAyuda" />
					</items>

				</Menu>
				<Menu mnemonicParsing="false" text="Espectaculos">
					<items>
						<MenuItem mnemonicParsing="false" text="Ver espectáculos"
							onAction="#abrirEspectaculos" />
					</items>
				</Menu>
			</menus>
		</MenuBar>
	</top>
	<left>
		<VBox prefHeight="571.0" prefWidth="306.0" spacing="20"
			styleClass="background" BorderPane.alignment="CENTER">

			<children>

				<Label text="Gestión de Personas" textFill="WHITE">
					<font>
						<Font size="20.0" />
					</font>
				</Label>

				<!-- FORMULARIO ALINEADO -->
				<GridPane hgap="10" vgap="12">
					<columnConstraints>
						<ColumnConstraints halignment="RIGHT"
							minWidth="110" />
						<ColumnConstraints halignment="LEFT"
							minWidth="180" />
					</columnConstraints>

					<children>

						<!-- Nombre -->
						<Label text="Nombre:" textFill="WHITE" GridPane.rowIndex="0"
							GridPane.columnIndex="0" />
						<TextField fx:id="nombre" prefHeight="30"
							promptText="Nombre" GridPane.rowIndex="0"
							GridPane.columnIndex="1" />

						<!-- Nacionalidad -->
						<Label text="Nacionalidad:" textFill="WHITE"
							GridPane.rowIndex="1" GridPane.columnIndex="0" />
						<TextField fx:id="nacionalidad" prefHeight="30"
							promptText="Nacionalidad" GridPane.rowIndex="1"
							GridPane.columnIndex="1" />

						<!-- Usuario -->
						<Label text="Usuario:" textFill="WHITE"
							GridPane.rowIndex="2" GridPane.columnIndex="0" />
						<TextField fx:id="username" prefHeight="30"
							promptText="Nombre de usuario" GridPane.rowIndex="2"
							GridPane.columnIndex="1" />

						<!-- Tipo persona -->
						<Label text="Tipo:" textFill="WHITE" GridPane.rowIndex="3"
							GridPane.columnIndex="0" />
						<ComboBox fx:id="tipoPersona" prefHeight="30"
							prefWidth="180" promptText="Seleccione tipo"
							GridPane.rowIndex="3" GridPane.columnIndex="1" />

						<!-- Email -->
						<Label text="Email:" textFill="WHITE" GridPane.rowIndex="4"
							GridPane.columnIndex="0" />
						<TextField fx:id="email" prefHeight="30"
							promptText="Email" GridPane.rowIndex="4" GridPane.columnIndex="1" />

						<!-- Password -->
						<Label text="Contraseña: " textFill="WHITE"
							GridPane.rowIndex="5" GridPane.columnIndex="0" />
						<PasswordField fx:id="password" prefHeight="30"
							promptText="Contraseña" GridPane.rowIndex="5"
							GridPane.columnIndex="1" />

					</children>
				</GridPane>

				<!-- CAMPOS ARTISTA -->
				<VBox fx:id="camposArtista" visible="false" managed="false"
					spacing="5">
					<Label text="Apodo:" textFill="WHITE" />
					<TextField fx:id="apodo" promptText="Apodo (opcional)"
						prefHeight="30" prefWidth="50" maxWidth="180" />


					<Label text="Especialidades:" textFill="WHITE" />
					<CheckBox fx:id="chkAcrobacia" text="Acrobacia"
						textFill="WHITE" />
					<CheckBox fx:id="chkHumor" text="Humor" textFill="WHITE" />
					<CheckBox fx:id="chkMagia" text="Magia" textFill="WHITE" />
					<CheckBox fx:id="chkEquilibrismo" text="Equilibrismo"
						textFill="WHITE" />
					<CheckBox fx:id="chkMalabarismo" text="Malabarismo"
						textFill="WHITE" />
				</VBox>

				<!-- CAMPOS COORDINACIÓN -->
				<VBox fx:id="camposCoordinacion" visible="false"
					managed="false" spacing="5">
					<CheckBox fx:id="chkSenior" text="¿Es senior?"
						textFill="WHITE" />
					<DatePicker fx:id="fechaSenior"
						promptText="Fecha senior" visible="false" managed="false" />
				</VBox>

				<!-- BOTONES -->
				<HBox spacing="10" alignment="CENTER">
					<Button fx:id="limpiarButton" text="Limpiar" prefWidth="80"
						onAction="#limpiar" />
					<Button fx:id="guardarButton" text="Guardar" prefWidth="80"
						onAction="#saveUser" styleClass="btnGreen" textFill="WHITE" />
					<Button fx:id="deleteButton" text="Eliminar" prefWidth="80"
						onAction="#deleteUsers" />
				</HBox>		
						
				<HBox spacing="10" alignment="CENTER">
					<Button text="Carnet del Artista"
						onAction="#onGenerarCarnet" />
					<Button text="Informe Estadístico"
						onAction="#onGenerarEstadistico" />
				</HBox>

				

			</children>

			<padding>
				<Insets top="10" left="10" right="10" bottom="10" />
			</padding>

		</VBox>
	</left>

	<center>
		<VBox alignment="TOP_RIGHT" prefHeight="571.0" prefWidth="679.0"
			BorderPane.alignment="CENTER" spacing="10">
			<padding>
				<Insets top="10" left="10" right="20" bottom="10" />
			</padding>
			<children>
				<HBox alignment="TOP_RIGHT" prefHeight="41.0" prefWidth="640.0">
					<children>
						<Button fx:id="btnLogout" mnemonicParsing="false"
							onAction="#logout" prefHeight="30.0" prefWidth="100.0"
							styleClass="background" text="Cerrar sesión" textFill="#fff9f9"
							textOverrun="CLIP">
							<font>
								<Font size="13.0" />
							</font>

							<effect>
								<DropShadow blurType="ONE_PASS_BOX" color="#1965d0" />
							</effect>
						</Button>
					</children>
				</HBox>
				<TableView fx:id="userTable" prefHeight="300.0"
					tableMenuButtonVisible="false">
					<columns>
						<TableColumn fx:id="colUserId" prefWidth="50.0"
							text="ID" />
						<TableColumn fx:id="colName" prefWidth="100.0"
							text="Nombre" />
						<TableColumn fx:id="colNacion" prefWidth="100.0"
							text="Nacionalidad" />
						<TableColumn fx:id="colEmail" prefWidth="100.0"
							text="Email" />
						<TableColumn fx:id="colTipoPersona" prefWidth="100.0"
							text="Tipo" />
						<TableColumn fx:id="colEdit" prefWidth="70.0"
							text="Edit" />
					</columns>

					<columnResizePolicy>
						<TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
					</columnResizePolicy>

					<contextMenu>
						<ContextMenu>
							<items>
								<MenuItem mnemonicParsing="false"
									onAction="#deleteUsers" text="Eliminar" />

							</items>
						</ContextMenu>
					</contextMenu>
				</TableView>
			</children>
		</VBox>
	</center>
</BorderPane>
