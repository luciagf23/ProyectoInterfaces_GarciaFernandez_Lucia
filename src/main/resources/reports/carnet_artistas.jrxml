	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="MySQL_TareaInterfaces"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<parameter name="id_artista" class="java.lang.Long"/>
	<parameter name="fecha_emision" class="java.sql.Date"/>
	<queryString language="SQL">
		<![CDATA[SELECT 
    p.id,
    p.nombre,
    a.apodo,
    p.nacionalidad,
    p.email,
    GROUP_CONCAT(e.especialidades SEPARATOR ', ') AS especialidades
FROM persona p
LEFT JOIN artista a ON p.id = a.id
LEFT JOIN artista_especialidades e ON a.id = e.artista_id
WHERE p.id = $P{id_artista}]]>
	</queryString>
